<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>#397: the related DML just applied everything the payload described, so the payload's job is done. It stays written with the parent save for crash and fault safety, and clears only on this success path - conversion then finds nothing to double-process. Guests never reach this element, so their payload still rides into conversion.</description>
        <name>Assign_Clear_Additional_Data</name>
        <label>Assign Clear Additional Data</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>record.%%%NAMESPACE%%%Internal_Additional_Data__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Clear_Additional_Data</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>#397: the upsert writes the new Ids into Filter_Upsert_Records, and the caller needs them back. Without the Ids a row that was added, saved and then removed would be spliced client-side instead of marked for delete, orphaning the created record.</description>
        <name>Assign_Upserted_Output</name>
        <label>Assign Upserted Output</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>upsertedRelatedRecords</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Filter_Upsert_Records</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Switch_Related_DML</targetReference>
        </connector>
    </assignments>
    <assignments>
/        <description>Prefixes $Flow.FaultMessage with the step that failed and captures both into the outputs; the section or component shows the real DML failure instead of failing silently, which matters most for guest users who have no other error surface.</description>
        <name>Assign_Error_Message</name>
        <label>Assign Error Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>hasError</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>failedStep</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>: </stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Names the step that failed so the message the form shows says which save was refused.</description>
        <name>Fault_Upsert_Form_Submission</name>
        <label>Fault: Form Submission save</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>failedStep</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Form Submission save</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Assign_Error_Message</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Names the step that failed so the message the form shows says which save was refused.</description>
        <name>Fault_Update_Form_Submission</name>
        <label>Fault: Form Submission update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>failedStep</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Form Submission update</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Assign_Error_Message</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Names the step that failed so the message the form shows says which save was refused.</description>
        <name>Fault_Upsert_DML</name>
        <label>Fault: Related record save</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>failedStep</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Related record save</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Assign_Error_Message</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Names the step that failed so the message the form shows says which save was refused.</description>
        <name>Fault_Update_DML</name>
        <label>Fault: Related record update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>failedStep</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Related record update</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Error_Message</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Names the step that failed so the message the form shows says which save was refused.</description>
        <name>Fault_Delete_DML</name>
        <label>Fault: Related record delete</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>failedStep</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Related record delete</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Assign_Error_Message</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Names the step that failed so the message the form shows says which save was refused.</description>
        <name>Fault_Clear_Additional_Data</name>
        <label>Fault: Additional data clear</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>failedStep</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Additional data clear</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Assign_Error_Message</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Links the stage to its submission before saving, so stage progress always hangs off the saved record even on a first save.</description>
        <name>Assign_Form_Submission_Id</name>
        <label>Assign Form Submission Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>stage.%%%NAMESPACE%%%Form_Submission__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>record.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Upsert_Stage_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Links each row to its parent before staging. The parent Id exists because the submission always saves before its rows in the sequencer order.</description>
        <name>Assign_Form_Submission_Id_Loop</name>
        <label>Assign Form Submission Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Related_Records.%%%NAMESPACE%%%Parent_Form_Submission__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>upsertCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Related_Records</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Related_Records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>#261: intentional no-op fault sink. A stage-save fault is handled and IGNORED (no error flag, no message) so the interview finishes cleanly and the submission save stands. Guests in user mode can never update a transferred stage; stage progress is auxiliary metadata and must not block a save. The assignment re-asserts the hasError default purely because Flow requires an assignment item.</description>
        <name>Ignore_Stage_Fault</name>
        <label>Ignore Stage Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>hasError</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Save_Progress</name>
        <label>Assign Save Progress</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>record.%%%NAMESPACE%%%Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Saved</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>record.%%%NAMESPACE%%%Last_Saved_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Switch_DML</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <description>Rows the user removed that actually exist in the database. The components flag removals with the standard IsDeleted field in memory instead of dropping them, so the save layer can delete the persisted records.</description>
        <name>Filter_Delete_Records</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter (Delete Records)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_Delete_Records</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>upsertCollection</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Delete_Records.IsDeleted</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <booleanValue>true</booleanValue>
            </rightValue>
        </conditions>
        <conditions>
            <leftValueReference>currentItem_Filter_Delete_Records.Id</leftValueReference>
            <operator>IsBlank</operator>
            <rightValue>
                <booleanValue>false</booleanValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Switch_Related_DML</targetReference>
        </connector>
    </collectionProcessors>
    <collectionProcessors>
        <description>Existing rows (Id present) that the user did not remove, staged for a plain update.</description>
        <name>Filter_Update_Records</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter (Update Records)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_Update_Records</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>upsertCollection</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Update_Records.Id</leftValueReference>
            <operator>IsBlank</operator>
            <rightValue>
                <booleanValue>false</booleanValue>
            </rightValue>
        </conditions>
        <conditions>
            <leftValueReference>currentItem_Filter_Update_Records.IsDeleted</leftValueReference>
            <operator>NotEqualTo</operator>
            <rightValue>
                <booleanValue>true</booleanValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Filter_Delete_Records</targetReference>
        </connector>
    </collectionProcessors>
    <collectionProcessors>
        <description>New rows must carry a UniqueId to be created: a row with neither Id nor UniqueId is ignored by design, never saved. The form components generate the unique id per row; a custom caller must do the same or its new rows will silently not persist.</description>
        <name>Filter_Upsert_Records</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter (Upsert Records)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_Upsert_Records</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>upsertCollection</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Upsert_Records.Id</leftValueReference>
            <operator>IsBlank</operator>
            <rightValue>
                <booleanValue>true</booleanValue>
            </rightValue>
        </conditions>
        <conditions>
            <leftValueReference>currentItem_Filter_Upsert_Records.IsDeleted</leftValueReference>
            <operator>NotEqualTo</operator>
            <rightValue>
                <booleanValue>true</booleanValue>
            </rightValue>
        </conditions>
        <conditions>
            <leftValueReference>currentItem_Filter_Upsert_Records.%%%NAMESPACE%%%UniqueId__c</leftValueReference>
            <operator>IsBlank</operator>
            <rightValue>
                <booleanValue>false</booleanValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Filter_Update_Records</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <description>The sequencer: after each operation the flow re-enters here and WasVisited guards pick the next unfinished job in order. A brand-new submission (no Id) requires a populated UniqueId and inserts through the external-id upsert; a record that ARRIVED with an Id updates instead (the upsert-not-visited guard, #262, keeps a record born in this interview from being redundantly re-updated, which guests cannot survive); then related records, then the stage. Each rule&apos;s conditions are the contract for what gets saved at all.</description>
        <name>Switch_DML</name>
        <label>Swtich</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>return</defaultConnectorLabel>
        <rules>
            <name>Upsert_Form_Submission_DML</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>record.%%%NAMESPACE%%%UniqueId__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>record.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Upsert_Form_Submission</leftValueReference>
                <operator>WasVisited</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Upsert_Form_Submission</targetReference>
            </connector>
            <label>Upsert (Form Submission)</label>
        </rules>
        <rules>
            <name>Update_Form_Submission_DML</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>record.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Update_Form_Submission</leftValueReference>
                <operator>WasVisited</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Upsert_Form_Submission</leftValueReference>
                <operator>WasVisited</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Form_Submission</targetReference>
            </connector>
            <label>Update (Form Submission)</label>
        </rules>
        <rules>
            <name>Upsert_Related_Records_DML</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>relatedRecords</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>relatedRecords</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Related_Records</leftValueReference>
                <operator>WasVisited</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Related_Records</targetReference>
            </connector>
            <label>Upsert (Related Records)</label>
        </rules>
        <rules>
            <name>Upsert_Stage_DML</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>stage</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>stage.%%%NAMESPACE%%%Form_Template_Page__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Form_Submission_Id</targetReference>
            </connector>
            <label>Upsert (Stage)</label>
        </rules>
    </decisions>
    <decisions>
        <description>Sends each group of related records to the right action: create new ones, update existing ones, or delete the ones the user removed.</description>
        <name>Switch_Related_DML</name>
        <label>Switch</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Clear_Additional_Data</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>return</defaultConnectorLabel>
        <rules>
            <name>Do_Delete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Filter_Delete_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Filter_Delete_Records</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Delete_DML</leftValueReference>
                <operator>WasVisited</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_DML</targetReference>
            </connector>
            <label>Delete</label>
        </rules>
        <rules>
            <name>Do_Upsert</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Filter_Upsert_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Filter_Upsert_Records</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Upsert_DML</leftValueReference>
                <operator>WasVisited</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Upsert_DML</targetReference>
            </connector>
            <label>Upsert</label>
        </rules>
        <rules>
            <name>Do_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Filter_Update_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Filter_Update_Records</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Update_DML</leftValueReference>
                <operator>WasVisited</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_DML</targetReference>
            </connector>
            <label>Update</label>
        </rules>
    </decisions>
    <decisions>
        <description>SaveProgress true stamps Saved and the last saved date; otherwise records save with whatever status the caller set. By design this flow never writes Submitted: submitting is the form&apos;s decision, not the save layer&apos;s.</description>
        <name>Switch_Save_Progress</name>
        <label>Switch</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Switch_DML</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>continue</defaultConnectorLabel>
        <rules>
            <name>Mark_Save_Progress</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SaveProgress</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Save_Progress</targetReference>
            </connector>
            <label>Mark Save Progress</label>
        </rules>
    </decisions>
    <description>Client-owned override of the packaged (Form) Upsert | Overridable flow, installed by the Flow Tool Kit installer for guest sites. Runs in System Mode Without Sharing so a guest can update a submission and save one that points at records the guest cannot read. Installed inactive: review it, activate it, and assign the Form Flow (Guest User) permission set to the site&apos;s guest user. Keep it to saving the submission it receives.</description>
    <environments>Default</environments>
    <interviewLabel>(Form) Upsert | Guest Override {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <label>(Form) Upsert | Guest Override</label>
    <loops>
        <name>Loop_Related_Records</name>
        <label>Loop Related Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>relatedRecords</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Form_Submission_Id_Loop</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Filter_Upsert_Records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <overriddenFlow>%%%NAMESPACE%%%Form_Submission_Upsert</overriddenFlow>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Creates the new rows in one all-or-none operation, matching by the same unique id so replays cannot duplicate rows.</description>
        <name>Upsert_DML</name>
        <label>Upsert</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_Upserted_Output</targetReference>
        </connector>
        <doesUpsert>true</doesUpsert>
        <doesUpsertAllOrNone>true</doesUpsertAllOrNone>
        <faultConnector>
            <targetReference>Fault_Upsert_DML</targetReference>
        </faultConnector>
        <inputReference>Filter_Upsert_Records</inputReference>
        <upsertExternalIdField>FlowToolKit__UniqueId__c</upsertExternalIdField>
    </recordCreates>
    <recordCreates>
        <description>First-save idempotency: upserting by FlowToolKit__UniqueId__c (unique, unlike the legacy %%%NAMESPACE%%%ExternalId__c, #256) means two saves carrying the same client-generated unique id resolve to one record, which is what makes autosave, retries, and double clicks safe on new submissions. A failed save ends the flow through Assign_Error_Message; it used to return to the sequencer, which had nothing left to run, so the interview finished with hasError false and a guest saw Submitted successfully with no record.</description>
        <name>Upsert_Form_Submission</name>
        <label>Upsert</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Switch_DML</targetReference>
        </connector>
        <doesUpsert>true</doesUpsert>
        <faultConnector>
            <targetReference>Fault_Upsert_Form_Submission</targetReference>
        </faultConnector>
        <inputReference>record</inputReference>
        <upsertExternalIdField>FlowToolKit__UniqueId__c</upsertExternalIdField>
    </recordCreates>
    <recordCreates>
        <description>Saves Stages mode progress, gated on the stage carrying its Form Template Page: a stage without a page pointer is not meaningful progress and is skipped by the sequencer&apos;s conditions.</description>
        <name>Upsert_Stage_Record</name>
        <label>Upsert (Stage)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesUpsert>true</doesUpsert>
        <faultConnector>
            <targetReference>Ignore_Stage_Fault</targetReference>
        </faultConnector>
        <inputReference>stage</inputReference>
    </recordCreates>
    <recordDeletes>
        <name>Delete_DML</name>
        <label>Delete</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Switch_Related_DML</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Delete_DML</targetReference>
        </faultConnector>
        <inputReference>Filter_Delete_Records</inputReference>
    </recordDeletes>
    <recordUpdates>
        <description>#397: persists the cleared payload after the related DML succeeds. A one-field write keyed by Id, so it cannot re-fire the full-record save.</description>
        <name>Clear_Additional_Data</name>
        <label>Clear Additional Data</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Switch_DML</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Clear_Additional_Data</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>%%%NAMESPACE%%%Internal_Additional_Data__c</field>
            <value>
                <elementReference>record.%%%NAMESPACE%%%Internal_Additional_Data__c</elementReference>
            </value>
        </inputAssignments>
        <object>%%%NAMESPACE%%%Form_Submission__c</object>
    </recordUpdates>
    <recordUpdates>
        <description>Updates the related records that already exist.</description>
        <name>Update_DML</name>
        <label>Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Switch_Related_DML</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Update_DML</targetReference>
        </faultConnector>
        <inputReference>Filter_Update_Records</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Updates an existing submission. Kept separate from the create step so a saved submission is never duplicated.</description>
        <name>Update_Form_Submission</name>
        <label>Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Switch_DML</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Update_Form_Submission</targetReference>
        </faultConnector>
        <inputReference>record</inputReference>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Switch_Save_Progress</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>currentItem_Filter_Delete_Records</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>%%%NAMESPACE%%%Form_Submission__c</objectType>
    </variables>
    <variables>
        <name>currentItem_Filter_Update_Records</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>%%%NAMESPACE%%%Form_Submission__c</objectType>
    </variables>
    <variables>
        <name>currentItem_Filter_Upsert_Records</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>%%%NAMESPACE%%%Form_Submission__c</objectType>
    </variables>
    <variables>
        <description>Output: the raw fault message from the failed step.</description>
        <name>errorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
    <variables>
        <description>The step whose fault reached Assign_Error_Message, prefixed onto errorMessage.</description>
        <name>failedStep</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Output: true when any save step failed; paired with errorMessage so the caller can show the fault and keep the user&apos;s data on screen.</description>
        <name>hasError</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>The debounce contract: the caller passes the button click timestamp and this flow echoes it back unchanged. The Flow Section screen triggers compare the newest click to the echoed value and only re-run the save when the click is newer and no save is in progress, so each click saves exactly once.</description>
        <name>LastTriggeredDateTime</name>
        <dataType>DateTime</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>The Form Submission to upsert. Handles both INSERT (no Id, requires ExternalId) and UPDATE (existing Id). On exit the same record is echoed back so the caller can observe the stamped Id from an insert and any side effects of an override.</description>
        <name>record</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>%%%NAMESPACE%%%Form_Submission__c</objectType>
    </variables>
    <variables>
        <description>Output: the rows Upsert_DML created or matched this run, carrying their Ids. The client reconciles these back onto its working rows so a later remove routes to a delete instead of a splice.</description>
        <name>upsertedRelatedRecords</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>%%%NAMESPACE%%%Form_Submission__c</objectType>
    </variables>
    <variables>
        <description>Input: repeater and table rows to save alongside the submission. Rows follow the Id/ExternalId/IsDeleted contract described on the filter elements.</description>
        <name>relatedRecords</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>%%%NAMESPACE%%%Form_Submission__c</objectType>
    </variables>
    <variables>
        <description>Input: true stamps the save as a Saved draft. This flow never stamps Submitted regardless of this flag; final status belongs to the caller.</description>
        <name>SaveProgress</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>Input and output: the Form Submission Stage to save in Stages mode. Only saved when it carries its Form Template Page.</description>
        <name>stage</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>%%%NAMESPACE%%%Form_Submission_Stage__c</objectType>
    </variables>
    <variables>
        <name>upsertCollection</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>%%%NAMESPACE%%%Form_Submission__c</objectType>
    </variables>
</Flow>
