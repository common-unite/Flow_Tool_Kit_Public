    <status>Active</status>
    <transforms>
        <description>What an affiliation carries. Only the fields mapped here are written, so anything else on an existing affiliation (End Date, a custom field) keeps its value. Change what an affiliation carries here.</description>
        <name>Affiliation_Field_Map</name>
        <label>Affiliation (Field Map)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Upsert_Affiliation</targetReference>
        </connector>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <objectType>npe5__Affiliation__c</objectType>
        <scale>0</scale>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <outputFieldApiName>npe5__Contact__c</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>ContactId</elementReference>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>npe5__Organization__c</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>AccountId</elementReference>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>npe5__Status__c</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <stringValue>Current</stringValue>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>npe5__StartDate__c</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <formulaDataType>Date</formulaDataType>
                    <formulaExpression>BlankValue({!getCurrentAffiliation.npe5__StartDate__c},TODAY())</formulaExpression>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>npe5__Role__c</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <formulaDataType>String</formulaDataType>
                    <formulaExpression>BlankValue({!Role},{!getCurrentAffiliation.npe5__Role__c})</formulaExpression>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>npe5__Primary__c</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <formulaDataType>Boolean</formulaDataType>
                    <formulaExpression>IF(AND(IsBlank({!getContact.npsp__Primary_Affiliation__c}), IsBlank({!getExistingPrimaryAffiliation.Id})), true, IF(OR({!getContact.npsp__Primary_Affiliation__c} = {!AccountId}, {!getExistingPrimaryAffiliation.npe5__Organization__c} = {!AccountId}), true, IF(IsBlank({!getCurrentAffiliation.Id}), false, {!getCurrentAffiliation.npe5__Primary__c})))</formulaExpression>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>Id</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>getCurrentAffiliation.Id</elementReference>
                </value>
            </transformValueActions>
        </transformValues>
    </transforms>
