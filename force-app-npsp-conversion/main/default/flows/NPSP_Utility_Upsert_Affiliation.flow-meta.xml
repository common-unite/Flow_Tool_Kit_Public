    <variables>
        <description>The person&apos;s role at the Organization, such as their job title. Optional: when blank, an existing affiliation keeps its Role.</description>
        <name>Role</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
