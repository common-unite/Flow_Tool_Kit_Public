    <recordCreates>
        <description>Inserted or updated by the Id the map carries: the Current affiliation found above, blank when there is none.</description>
        <name>Upsert_Affiliation</name>
        <label>Upsert Affiliation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_Outputs</targetReference>
        </connector>
        <doesUpsert>true</doesUpsert>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Assign_Error</targetReference>
        </faultConnector>
        <inputReference>Affiliation_Field_Map</inputReference>
        <upsertStandardIdField>Id</upsertStandardIdField>
    </recordCreates>
    <recordLookups>
        <description>Any affiliation already marked Primary for this person. NPSP only maintains Contact.npsp__Primary_Affiliation__c when automatic affiliation creation is on, so the affiliation records are the reliable source.</description>
        <name>getExistingPrimaryAffiliation</name>
        <label>Existing Primary Affiliation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>getCurrentAffiliation</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Assign_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>npe5__Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>npe5__Primary__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>npe5__Affiliation__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>npe5__Organization__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>The Contact&apos;s current Primary Affiliation. NPSP retires a person&apos;s previous primary affiliation (Former, End Date today) whenever a new one is marked Primary, so this flow only marks Primary when the person has none yet or it is already this Organization - an existing employer is never closed out by a form.</description>
        <name>getContact</name>
        <label>Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>getExistingPrimaryAffiliation</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Assign_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ContactId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>npsp__Primary_Affiliation__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>The Contact&apos;s Current affiliation to this Organization, newest Start Date first. Its Id makes the save an update; blank means a new affiliation is inserted. Current (not a blank End Date) is the key NPSP orgs&apos; affiliation duplicate guards use, and a Former affiliation stays as history.</description>
        <name>getCurrentAffiliation</name>
        <label>Current Affiliation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Affiliation_Field_Map</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Assign_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>npe5__Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>npe5__Organization__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>npe5__Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Current</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>npe5__Affiliation__c</object>
        <sortField>npe5__StartDate__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>The Account to affiliate with, read so its record type can be checked: only an Organization is affiliated.</description>
        <name>getOrganization</name>
        <label>Organization</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
