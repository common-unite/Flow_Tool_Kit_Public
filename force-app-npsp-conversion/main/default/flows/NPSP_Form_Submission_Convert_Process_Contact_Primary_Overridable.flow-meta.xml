                    <formulaDataType>String</formulaDataType>
                    <formulaExpression>BLANKVALUE({!FormSubmission.Contact1_MobilePhone__c}, IF(TEXT({!FormSubmission.Contact1_Phone_Type__c}) = &apos;Mobile&apos;, {!FormSubmission.Contact1_Phone__c}, null))</formulaExpression>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>npe01__WorkPhone__c</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <formulaDataType>String</formulaDataType>
                    <formulaExpression>IF(TEXT({!FormSubmission.Contact1_Phone_Type__c}) = &apos;Work&apos;, {!FormSubmission.Contact1_Phone__c}, null)</formulaExpression>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>npsp__Do_Not_Contact__c</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <formulaDataType>Boolean</formulaDataType>
                    <formulaExpression>IF({!FormSubmission.Contact1_DoNotCall__c}, true, null)</formulaExpression>
                </value>
            </transformValueActions>
        </transformValues>
