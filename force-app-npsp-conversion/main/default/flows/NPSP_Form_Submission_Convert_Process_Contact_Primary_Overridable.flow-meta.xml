                <transformType>Map</transformType>
                <value>
                    <formulaDataType>String</formulaDataType>
                    <formulaExpression>IF(TEXT({!FormSubmission.Contact1_Phone_Type__c}) = &apos;Home&apos;, {!FormSubmission.Contact1_Phone__c}, null)</formulaExpression>
