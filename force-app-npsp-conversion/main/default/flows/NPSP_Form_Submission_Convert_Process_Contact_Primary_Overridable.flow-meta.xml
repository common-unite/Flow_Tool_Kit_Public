                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>npe01__HomeEmail__c</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <formulaDataType>String</formulaDataType>
                    <formulaExpression>IF(TEXT({!FormSubmission.Contact1_Email_Type__c}) = &apos;Personal&apos;, {!FormSubmission.Contact1_Email__c}, null)</formulaExpression>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>npe01__WorkEmail__c</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <formulaDataType>String</formulaDataType>
                    <formulaExpression>IF(TEXT({!FormSubmission.Contact1_Email_Type__c}) = &apos;Work&apos;, {!FormSubmission.Contact1_Email__c}, null)</formulaExpression>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>npe01__AlternateEmail__c</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <formulaDataType>String</formulaDataType>
                    <formulaExpression>IF(TEXT({!FormSubmission.Contact1_Email_Type__c}) = &apos;Other&apos;, {!FormSubmission.Contact1_Email__c}, null)</formulaExpression>
