<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Header_Top_Margin__c</fullName>
    <defaultValue>&apos;slds-m-top_small&apos;</defaultValue>
    <description>SLDS top-margin utility class (slds-m-top_none through slds-m-top_large) applied above the section header when Show Header is checked. Passed as top-margin to the section's form/header component. Defaults to slds-m-top_small to match the base margin section headers receive in the Form Builder and Flow screens.</description>
    <inlineHelpText>Choose how much space appears above the section header. Larger values push the header down from whatever is above it; requires Show Header.</inlineHelpText>
    <label>Top Margin</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
