<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Repeater_Record_Spacing__c</fullName>
    <description>#732: SLDS spacing size (none through xx-large) added above every repeater record, as slds-m-top_[size]: between records, and between the section's header or text and the first record. Independent of the divider. Blank keeps today's spacing. Passed as record-spacing to c-flow-form-repeat. Applies to Repeater sections only.</description>
    <inlineHelpText>Space above each repeated entry, including the first one. Works whether or not the divider is shown. Leave blank for the standard spacing.</inlineHelpText>
    <label>Record Spacing</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
