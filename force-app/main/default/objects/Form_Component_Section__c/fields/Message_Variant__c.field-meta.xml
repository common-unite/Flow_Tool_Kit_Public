<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Message_Variant__c</fullName>
    <label>Message Variant</label>
    <description>Renders a Rich Text section as a themed message card (info, warning, error, success). "Default" renders plain rich text.</description>
    <inlineHelpText>Choose a status style to render this rich text as a message card. "Default" keeps it as plain rich text.</inlineHelpText>
    <type>Picklist</type>
    <required>false</required>
    <valueSet>
        <restricted>false</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value><fullName>default</fullName><default>true</default><label>Default (plain text)</label></value>
            <value><fullName>info</fullName><default>false</default><label>Info</label></value>
            <value><fullName>warning</fullName><default>false</default><label>Warning</label></value>
            <value><fullName>error</fullName><default>false</default><label>Error</label></value>
            <value><fullName>success</fullName><default>false</default><label>Success</label></value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
