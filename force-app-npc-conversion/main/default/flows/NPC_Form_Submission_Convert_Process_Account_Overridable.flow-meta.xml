    <transforms>
        <description>THE clone target for custom Account mappings. Maps the submission&apos;s company fields onto the Account, applying billing and shipping addresses only when those conversion rules are enabled on the template. Values assigned here may still be blank; the Upsert Account subflow strips nulls afterward, so a blank answer never erases data on a matched Account. Add or change mappings here and leave the rest of the flow intact.</description>
        <name>Account_Field_Map</name>
        <label>Account (Field Map)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Switch_Record_Type</targetReference>
        </connector>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <objectType>Account</objectType>
        <scale>0</scale>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <outputFieldApiName>Id</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>FormSubmission.Account__c</elementReference>
                </value>
            </transformValueActions>
            <transformValueActions>
