<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Something failed to save. The flow returns HasError = true and the platform's error text, and lets the caller decide what to log or show.</description>
        <name>Assign_Error</name>
        <label>Report the failure</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>HasError</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Hands the membership's Id back to the caller.</description>
        <name>Assign_Outputs</name>
        <label>Assign Outputs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>AccountContactRelationId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Membership_Field_Map.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ConversionStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ConversionStatusValue</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Switch_Clear_Other_Primary_Groups</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Marks the membership being saved as the primary member, after the seat has been confirmed or made free.</description>
        <name>Assign_Primary_Member</name>
        <label>Assign Primary Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Membership_Field_Map.IsPrimaryMember</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Upsert_Membership</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Only when the caller asked for both: this Account became the person's primary group, and their other memberships should stop being primary. Skipped otherwise, so the flow never touches records it was not asked about.</description>
        <name>Switch_Clear_Other_Primary_Groups</name>
        <label>Switch</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>return</defaultConnectorLabel>
        <rules>
            <name>Clear_other_Primary_Groups</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ClearOtherPrimaryGroups</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsPrimaryGroup</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_Others</targetReference>
            </connector>
            <label>Clear other Primary Groups</label>
        </rules>
    </decisions>
    <decisions>
        <description>Three ways forward: the seat is free and requested (take it), the seat is taken and requested (demote the holder first), or the request leaves the seat alone (save as mapped).</description>
        <name>Switch_Primary_Member_Check</name>
        <label>Switch</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Upsert_Membership</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>continue</defaultConnectorLabel>
        <rules>
            <name>Has_no_Primary_Member</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getPrimaryMember</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Primary_Member</targetReference>
            </connector>
            <label>No Primary Member yet</label>
        </rules>
        <rules>
            <name>Switch_Primary_Member</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsPrimaryMember</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>getPrimaryMember</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>getPrimaryMember.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Existing_Primary_Member</targetReference>
            </connector>
            <label>Replace the Primary Member</label>
        </rules>
    </decisions>
    <description>WHAT IT DOES: Makes a Contact a member of an Account (in Nonprofit Cloud terms: puts a person in a Household) with the membership flags you ask for, and returns the relationship's Id. Running it twice never creates a duplicate, because Salesforce only ever allows one Account Contact Relation per Contact and Account pair.

HOW IT WORKS, STEP BY STEP:
1. Looks for the existing relationship between this Contact and this Account. If there is one, its Id rides into the field map, turning the save into an update.
2. Looks up who is currently the Account's primary member (its head of household). Salesforce enforces exactly one primary member per Account, so this flow has to know before it writes.
3. Builds the membership in the Membership (Field Map) transform: the two Ids, active, the Is Primary Group and Is Included In Group flags from the inputs, and the start date preserved from the existing relationship.
4. The primary member request is handled with care: if nobody holds the role, the flag is simply set; if somebody else holds it and you asked for this person, the current holder is demoted first, then this person is promoted. Your request is honoured without ever tripping the platform's one-primary-member rule.
5. One Create element set to upsert on Id saves it, insert or update as the map decides.
6. If Clear Other Primary Groups was requested along with Is Primary Group, every OTHER membership this person has is demoted from primary group, because Salesforce does not enforce one primary group per person and reporting expects exactly one.

WHERE IT FITS: The NPC Account engine calls this whenever a converted person should join the conversion's Account (Household mode, or the Add to Account conversion rules). It is form-agnostic: call it from your own automation any time you need a person in an Account with the right flags. It never writes logs; it returns HasError and ErrorMessage instead.</description>
    <environments>Default</environments>
    <formulas>
        <description>Created when no existing relationship was found, Updated otherwise: decided by the same lookup that made the save an update.</description><name>ConversionStatusValue</name>
        <dataType>String</dataType>
        <expression>if(IsBlank({!getExistingRelationship.Id}),'Created','Updated')</expression>
    </formulas>
    <interviewLabel>(NPC) Utility | Upsert | Account Contact Relation {!$Flow.CurrentDateTime}</interviewLabel>
    <isOverridable>true</isOverridable>
    <label>(NPC) Utility | Upsert | Account Contact Relation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Inserted or updated by the Id the map carries: the membership found above when these two are already related, blank when they are not.</description>
        <name>Upsert_Membership</name>
        <label>Upsert Membership</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_Outputs</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Assign_Error</targetReference>
        </faultConnector>
        <doesUpsert>true</doesUpsert>
        <inputReference>Membership_Field_Map</inputReference>
        <upsertStandardIdField>Id</upsertStandardIdField>
    </recordCreates>
    <recordLookups>
        <description>The relationship these two records may already have. Its Id makes the save an update; blank means a brand-new membership will be inserted.</description>
        <name>getExistingRelationship</name>
        <label>Existing Relationship</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>getPrimaryMember</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Assign_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AccountContactRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Whoever currently holds the Account's one primary member seat. Needed before writing, because the platform refuses a second primary member.</description>
        <name>getPrimaryMember</name>
        <label>Primary Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Membership_Field_Map</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Assign_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsPrimaryMember</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AccountContactRelation</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Demotes this person's primary group flag everywhere else. Salesforce happily leaves a person with two primary groups; rollups and reporting expect one, so this flow enforces it.</description>
        <name>Clear_Others</name>
        <label>Demote the Others</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Assign_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsPrimaryGroup</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>IsPrimaryGroup</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>AccountContactRelation</object>
    </recordUpdates>
    <recordUpdates>
        <description>Demotes the current primary member so the requested person can take the seat without the platform rejecting the save.</description>
        <name>Update_Existing_Primary_Member</name>
        <label>Existing Primary Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Assign_Primary_Member</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Assign_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>getPrimaryMember.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>IsPrimaryMember</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>AccountContactRelation</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>getExistingRelationship</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <transforms>
        <description>What a membership carries. Is Primary Member is deliberately absent: only the fields mapped here are written, so an existing membership keeps the flag it has. Change what a membership carries here.</description>
        <name>Membership_Field_Map</name>
        <label>Membership (Field Map)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Switch_Primary_Member_Check</targetReference>
        </connector>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <objectType>AccountContactRelation</objectType>
        <scale>0</scale>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <outputFieldApiName>AccountId</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>AccountId</elementReference>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>ContactId</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>ContactId</elementReference>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>IsActive</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <booleanValue>true</booleanValue>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>IsPrimaryGroup</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>IsPrimaryGroup</elementReference>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>IsIncludedInGroup</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>IsIncludedInGroup</elementReference>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>StartDate</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <formulaDataType>Date</formulaDataType>
                    <formulaExpression>BlankValue({!getExistingRelationship.StartDate},TODAY())</formulaExpression>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>EndDate</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <formulaDataType>Date</formulaDataType>
                    <formulaExpression>null</formulaExpression>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>Id</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>getExistingRelationship.Id</elementReference>
                </value>
            </transformValueActions>
        </transformValues>
    </transforms>
    <variables>
        <description>Output: the Id of the membership that now exists (created or updated).</description>
        <name>AccountContactRelationId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>The Account (a Household, or any other) the Contact belongs to. Required.</description>
        <name>AccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>When this Account becomes the person's primary group, demote every other membership of theirs.</description>
        <name>ClearOtherPrimaryGroups</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>The Contact to relate. Required.</description>
        <name>ContactId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Output: Created when this run made the membership, Updated when the pair were already related. The caller logs it so the Conversion Log speaks the framework's own vocabulary.</description><name>ConversionStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>What failed, in one sentence, for the caller to log or show.</description>
        <name>ErrorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>True when a step failed. The caller decides what to do; this flow never logs.</description>
        <name>HasError</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>Whether the person participates in the group's aggregation.</description>
        <name>IsIncludedInGroup</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>Whether this Account is the person's primary group (where their information rolls up).</description>
        <name>IsPrimaryGroup</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>Ask for this person to be the Account's principal member (head of household). Salesforce allows only one per Account, so the request is honoured safely: when nobody holds the role the person takes it, and when somebody else holds it the current holder is demoted first and this person is promoted. Note that the seat is also taken when it is empty and this is false, because an Account with members and no principal member is not a state worth creating.</description>
        <name>IsPrimaryMember</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
</Flow>